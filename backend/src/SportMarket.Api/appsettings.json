{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=SportMarketDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "SportMarket",
    "Audience": "SportMarketClient",
    // مقدار SecretKey عمداً خالی است و در user-secrets نگهداری می‌شود.
    // برای تنظیم محلی:  dotnet user-secrets set "Jwt:SecretKey" "<your-secret>"
    "SecretKey": "",
    "ExpiryHours": 12
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
